<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control de Activos Fijos</title>
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        * {
            box-sizing: border-box;
        }
        body {
            margin: 0;
            padding: 0;
            background-color: #f4f6f9;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .app-container {
            display: flex;
            min-height: 100vh;
        }
        /* SIDEBAR IZQUIERDO ESTILO DASHBOARD PRO */
        .app-sidebar {
            width: 260px;
            background-color: #1e1e2d;
            color: #a2a3b7;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
        }
        .sidebar-brand {
            padding: 20px;
            font-size: 1.1rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #181824;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .sidebar-menu {
            padding: 15px 10px;
            overflow-y: auto;
            flex: 1;
        }
        .menu-category {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #565674;
            margin: 20px 10px 10px 10px;
            font-weight: 700;
        }
        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: #c4c5d6;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 4px;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }
        .sidebar-item:hover, .sidebar-item.active {
            background-color: #3699ff;
            color: #ffffff;
        }
        /* CONTENEDOR PRINCIPAL */
        .app-main {
            margin-left: 260px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .app-header {
            height: 70px;
            background-color: #ffffff;
            border-bottom: 1px solid #ebedf3;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .app-content {
            padding: 30px;
            flex: 1;
        }
        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
            color: #3f4254;
            font-weight: 600;
        }
    </style>
</head>
<body>

    <div class="app-container">
        
        <!-- BARRA LATERAL IZQUIERDA -->
        <nav class="app-sidebar">
            <div>
                <div class="sidebar-brand">
                    <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
                    <span>Control Activos</span>
                </div>
                
                <div class="sidebar-menu">
                    <a href="/Home/Index" class="sidebar-item active">
                        <i class="bi bi-grid-1x2-fill fs-5"></i>
                        <span>Dashboard</span>
                    </a>

                    <div class="menu-category">Gestión de Activos</div>
                    <a href="#" class="sidebar-item">
                        <i class="bi bi-box-seam fs-5"></i>
                        <span>Activos Fijos</span>
                    </a>
                    <a href="#" class="sidebar-item">
                        <i class="bi bi-tags fs-5"></i>
                        <span>Categorías</span>
                    </a>
                    <a href="#" class="sidebar-item">
                        <i class="bi bi-geo-alt fs-5"></i>
                        <span>Ubicaciones</span>
                    </a>

                    <div class="menu-category">Operaciones</div>
                    <a href="#" class="sidebar-item">
                        <i class="bi bi-person-check fs-5"></i>
                        <span>Asignaciones</span>
                    </a>
                    <a href="#" class="sidebar-item">
                        <i class="bi bi-tools fs-5"></i>
                        <span>Mantenimiento</span>
                    </a>

                    <div class="menu-category">Administración</div>
                    <a href="#" class="sidebar-item">
                        <i class="bi bi-people fs-5"></i>
                        <span>Usuarios y Roles</span>
                    </a>
                </div>
            </div>

            <!-- BOTÓN CERRAR SESIÓN -->
            <div style="padding: 20px;">
                <a href="/Login" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </a>
            </div>
        </nav>

        <!-- ÁREA DE TRABAJO DERECHA -->
        <div class="app-main">
            <!-- Header superior limpio -->
            <header class="app-header">
                <div class="fw-bold text-dark fs-5">Sistema de Gestión de Activos Fijos</div>
                <div class="user-info">
                    <i class="bi bi-person-circle fs-4 text-primary"></i>
                    <span>@Context.Session.GetString("UsuarioLogueado")</span>
                </div>
            </header>

            <!-- Contenido dinámico (Aquí se inyecta el Index.cshtml) -->
            <main class="app-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>