@model Systema_de_gestion_y_control_activos_fijos.Models.ActivoEntity

@{
    ViewData["Title"] = "Registrar Activo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Registrar Nuevo Activo</h3>
        <p class="text-muted small m-0">Formulario de alta para el catálogo escolar (RF-01).</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i> Volver al Catálogo
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CodigoInventario" class="form-label fw-semibold">Código de Inventario</label>
                    <input asp-for="CodigoInventario" class="form-control" placeholder="Ej: ACT-ESC-001" />
                    <span asp-validation-for="CodigoInventario" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NumeroSerie" class="form-label fw-semibold">Número de Serie</label>
                    <input asp-for="NumeroSerie" class="form-control" placeholder="Ej: SN-987654321" />
                    <span asp-validation-for="NumeroSerie" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre del Activo</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Laptop Core i5 - Laboratorio de Informática" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="FechaAdquisicion" class="form-label fw-semibold">Fecha de Adquisición</label>
                    <input asp-for="FechaAdquisicion" type="date" class="form-control" />
                    <span asp-validation-for="FechaAdquisicion" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CostoAdquisicion" class="form-label fw-semibold">Costo de Adquisición (RD$)</label>
                    <input asp-for="CostoAdquisicion" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="CostoAdquisicion" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CategoriaId" class="form-label fw-semibold">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                        <option value="">-- Seleccione Categoría --</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="UbicacionId" class="form-label fw-semibold">Ubicación Escolar</label>
                    <select asp-for="UbicacionId" class="form-select" asp-items="ViewBag.UbicacionId">
                        <option value="">-- Seleccione Ubicación --</option>
                    </select>
                    <span asp-validation-for="UbicacionId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EstadoId" class="form-label fw-semibold">Estado del Activo</label>
                    <select asp-for="EstadoId" class="form-select" asp-items="ViewBag.EstadoId">
                        <option value="">-- Seleccione Estado --</option>
                    </select>
                    <span asp-validation-for="EstadoId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ProveedorId" class="form-label fw-semibold">Proveedor</label>
                    <select asp-for="ProveedorId" class="form-select" asp-items="ViewBag.ProveedorId">
                        <option value="">-- Seleccione Proveedor --</option>
                    </select>
                    <span asp-validation-for="ProveedorId" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">Guardar Activo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}