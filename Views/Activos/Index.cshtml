@model IEnumerable<Systema_de_gestion_y_control_activos_fijos.Models.ActivoEntity>

@{
    ViewData["Title"] = "Catálogo de Activos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">Catálogo de Activos Escolares</h3>
        <p class="text-muted small m-0">Registro y consulta de equipos, mobiliario y herramientas (RF-01).</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm px-3 py-2">
        <i class="bi bi-plus-lg"></i> Registrar Nuevo Activo
    </a>
</div>

<!-- TARJETA DE TABLA DE ACTIVOS -->
<div class="card border-0 shadow-sm rounded-3 bg-white">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="py-3 px-3">Código de Inventario</th>
                        <th class="py-3 px-3">Número de Serie</th>
                        <th class="py-3 px-3">Activo</th>
                        <th class="py-3 px-3">Categoría</th>
                        <th class="py-3 px-3">Ubicación Escolar</th>
                        <th class="py-3 px-3">Costo Adquisición</th>
                        <th class="py-3 px-3">Estado</th>
                        <th class="py-3 px-3 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- Columna 1: Código de Inventario -->
                                <td class="py-3 px-3">
                                    <span class="fw-bold text-primary">@item.CodigoInventario</span>
                                </td>

                                <!-- Columna 2: Número de Serie -->
                                <td class="py-3 px-3">
                                    <span class="text-secondary font-monospace small bg-light px-2.5 py-1.5 rounded border d-inline-block">
                                        @(string.IsNullOrEmpty(item.NumeroSerie) ? "N/A" : item.NumeroSerie)
                                    </span>
                                </td>

                                <!-- Columna 3: Activo (Nombre y Descripción) -->
                                <td class="py-3 px-3">
                                    <div class="fw-semibold text-dark mb-1">@item.Nombre</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 220px;" title="@item.Descripcion">
                                        @item.Descripcion
                                    </small>
                                </td>

                                <!-- Columna 4: Categoría -->
                                <td class="py-3 px-3">
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5">
                                        @(item.Categoria != null ? item.Categoria.Nombre : "Sin categoría")
                                    </span>
                                </td>

                                <!-- Columna 5: Ubicación Escolar -->
                                <td class="py-3 px-3">
                                    <div class="d-flex align-items-start gap-2">
                                        <i class="bi bi-geo-alt-fill text-danger mt-1"></i>
                                        <div>
                                            <span class="fw-semibold d-block text-dark">@(item.Ubicacion != null ? item.Ubicacion.Nombre : "No asignada")</span>
                                            <small class="text-muted">@(item.Ubicacion != null ? item.Ubicacion.Edificio : "")</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- Columna 6: Costo de Adquisición -->
                                <td class="py-3 px-3 fw-bold text-success text-nowrap">
                                    RD$ @item.CostoAdquisicion.ToString("N2")
                                </td>

                                <!-- Columna 7: Estado -->
                                <td class="py-3 px-3">
                                    @if (item.EstadoActivo != null)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info px-2.5 py-1.5">
                                            @item.EstadoActivo.Nombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Sin estado</span>
                                    }
                                </td>

                                <!-- Columna 8: Acciones -->
                                <td class="py-3 px-3 text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-2.5 py-1.5" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-box-seam display-6 d-block mb-2 text-secondary opacity-50"></i>
                                No hay activos registrados en el catálogo actualmente.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>